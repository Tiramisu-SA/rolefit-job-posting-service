# Runtime environment: development | test | production
NODE_ENV=development

# Public REST API (consumed by the web frontend)
HTTP_PORT=3000

# Internal gRPC API (consumed by Job Discovery Service)
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# MongoDB - owned exclusively by this service. Other services must NOT connect to it.
MONGODB_URI=mongodb://localhost:27017/rolefit_job_posting

# AI Model Adapter (internal, not a separate microservice)
# "none" = stub adapter; no external AI calls are made.
AI_PROVIDER=none
AI_API_KEY=
